# Copy this file to .env and fill in the real values.
# .env is gitignored. Never commit it.

# From https://my.telegram.org -> API development tools.
# These identify the client library, not the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From @BotFather, the token it hands you when the bot is created.
TELEGRAM_BOT_TOKEN=

# Optional. Leave both blank to run the bot without any account features.
# When set, the bot can link Telegram accounts to portal accounts, list and
# save codes, and act as the second factor for portal sign in.
# The service key bypasses row level security, so treat it as a root password.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional. Shown as a button under the welcome message. Blank hides it.
DONATION_URL=

# Optional. Telegram user ids allowed to run the unlisted health command,
# comma separated for more than one. Blank switches the command off entirely.
# Find your id by messaging @userinfobot.
OWNER_TELEGRAM_ID=
