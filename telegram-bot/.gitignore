# Secrets
.env
.env.*
!.env.example

# Telethon session files. These are login credentials in disguise.
*.session
*.session-journal

# Runtime state: SQLite database, logs, downloaded media
data/
*.db
*.db-wal
*.db-shm
*.log

# Jua is committed on purpose. It is the font the portal draws the watermark
# in, it is licensed under the SIL Open Font License, and the bot needs the
# actual file because it renders on the server rather than in a browser.
# Anything else dropped into assets is yours and stays out of the repository.
assets/*
!assets/Jua-Regular.ttf
!assets/OFL.txt

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
